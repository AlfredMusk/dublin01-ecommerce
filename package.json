{
  "name": "dublin01-ecommerce",
  "version": "0.1.0",
  "private": true,
  "description": "DUBLIN/01 — storefront for a Dublin sneaker and contemporary streetwear retailer.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node_modules/.bin/concurrently -k -n html,css,server -c magenta,gray,blue \"npm:watch:html\" \"npm:watch:css\" \"npm:serve\"",
    "build:html": "node scripts/build-html.mjs",
    "watch:html": "node scripts/build-html.mjs --watch",
    "watch:css": "node_modules/.bin/tailwindcss -i ./src/css/main.css -o ./dist/css/main.css --watch",
    "build": "npm run build:html && node_modules/.bin/tailwindcss -i ./src/css/main.css -o ./dist/css/main.css --minify",
    "serve": "node_modules/.bin/serve . -l 3001",
    "preview": "npm run build && npm run serve",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run build && npm test",
    "lint": "for f in $(find src/js scripts tests -name '*.js' -o -name '*.mjs'); do node --check \"$f\" || exit 1; done"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.5",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3"
  }
}
